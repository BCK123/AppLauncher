<UserControl
    x:Class="AppLauncher.Views.VisionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:AppLauncher.Views"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:vm="clr-namespace:AppLauncher.ViewModels"
    prism:ViewModelLocator.AutoWireViewModel="True">


    <Grid Margin="4" Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="600" />

        </Grid.RowDefinitions>

        <!--  ================= 顶部：功能入口 =================  -->
        <controls:Card Margin="6" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />

                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />

                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  标题  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="图像识别"
                    TextAlignment="Center" />

                <!--  数据集路径  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="模型选择" />

                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="28"
                    Margin="6,0"
                    Text="{Binding DatasetPath, Mode=TwoWay}" />

                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin="6,5"
                    Command="{Binding BrowseDatasetCommand}"
                    Content="浏览" />



                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="图像选择" />
                <!--  按钮跨1+2列，填充右侧空白，和上方布局视觉统一  -->
                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="6,0,50,0"
                    Command="{Binding BrowseImageCommand}"
                    Content="浏览" />
                <RadioButton
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="80,0,0,0"
                    Content="gpu"
                    IsChecked="{Binding IsUseGpu, Mode=TwoWay}" />
                <Button
                    Grid.Row="3"
                    Grid.Column="2"
                    Command="{Binding ProcessImageCommand}"
                    Content="识别" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Center"
                    Text="{Binding ProcessTime, StringFormat=耗时{0}ms}" />
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Padding="30,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding ProcessResult, StringFormat=结果：{0}}" />
                <!--  预览图片【核心修改：灰色背景+等比拉伸】  -->
                <Border
                    Grid.Row="5"
                    Grid.ColumnSpan="3"
                    MinWidth="400"
                    MinHeight="400"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="#E5E5E5">
                    <!--  图片绑定缩放后的宽高，保留等比Stretch（双重保障）、内边距  -->
                    <Image
                        Width="{Binding ImageShowWidth}"
                        Height="{Binding ImageShowHeight}"
                        Margin="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding ImagePath}"
                        Stretch="Uniform" />
                </Border>


            </Grid>
        </controls:Card>



    </Grid>
</UserControl>
