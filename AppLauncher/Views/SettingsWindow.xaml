<Window
    x:Class="AppLauncher.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置"
    Width="520"
    Height="200"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="存储目录：" />
            <TextBox
                x:Name="TxtDir"
                Width="360"
                VerticalAlignment="Center" />
            <Button
                Margin="8,0,0,0"
                Click="BtnBrowse_Click"
                Content="浏览..." />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,12,0,0"
            Foreground="Gray"
            Text="留空使用默认 %APPDATA%\\AppLauncher" />

        <StackPanel
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Click="BtnCancel_Click"
                Content="取消" />
            <Button
                Width="80"
                Click="BtnSave_Click"
                Content="保存" />
        </StackPanel>
    </Grid>
</Window>
